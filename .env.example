# =====================================================================
# QUERY MY MEETING - 100% FREE SERVICES CONFIGURATION
# =====================================================================
# All services below have 100% FREE tiers or run locally with ZERO cost.
# You DO NOT need to enter credit cards or pay for subscriptions.
# Copy this file to '.env' to customize your setup.
# =====================================================================

# ---------------------------------------------------------------------
# 1. FREE LLM GENERATION & SYNTHESIS OPTIONS (Pick Any One)
# ---------------------------------------------------------------------

# OPTION A: Groq Cloud (RECOMMENDED - Ultra-fast, 100% Free Tier)
# Get Free API Key at: https://console.groq.com/keys
# Generous free limits for Llama 3.3 70B & Llama 3.1 8B (500+ tokens/sec)
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# OPTION B: Google Gemini API (100% Free Tier via Google AI Studio)
# Get Free API Key at: https://aistudio.google.com/app/apikey
# 1,500 requests/day, 1M token context window, completely free
GEMINI_API_KEY=
# LLM_MODEL=gemini-1.5-flash

# OPTION C: Ollama (100% Local, Offline, Open-Source, Free Forever)
# Download from: https://ollama.com/download
# Run: 'ollama run llama3.2'
# USE_OLLAMA=true
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# OPTION D: Hugging Face Serverless Inference API (Free Tier)
# Get Free Access Token at: https://huggingface.co/settings/tokens
# HF_TOKEN=
# LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# OPTION E: Built-in Zero-Cost Local Synthesis Engine
# If none of the keys above are set, the system automatically uses its
# built-in extractive/abstractive dialogue synthesis engine with $0 cost!


# ---------------------------------------------------------------------
# 2. FREE EMBEDDING OPTIONS (Pick Any One)
# ---------------------------------------------------------------------
# EMBEDDING_BACKEND options:
# - 'gemini': Google text-embedding-004 (Free API at https://aistudio.google.com/)
# - 'sentence-transformers': all-MiniLM-L6-v2 (Local CPU via HuggingFace)
# - 'ollama': nomic-embed-text (Local CPU via Ollama)
# - '' (empty): FallbackDeterministicEmbedder (Instant hash projection, zero download)
EMBEDDING_BACKEND=


# ---------------------------------------------------------------------
# 3. VECTOR DATABASE (100% Free)
# ---------------------------------------------------------------------
# Default: Local Embedded Qdrant storage (Zero cost, runs on disk, no cloud bill)
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION=meeting_transcripts

# Optional Free Cloud: Qdrant Cloud (1GB RAM cluster free forever without expiration)
# Register free at: https://cloud.qdrant.io/
# QDRANT_URL=https://<your-cluster>.qdrant.tech:6333
# QDRANT_API_KEY=<your-free-qdrant-api-key>


# ---------------------------------------------------------------------
# 4. OAUTH 2.0 SECURITY & ACCESS CONTROL (100% Free)
# ---------------------------------------------------------------------
# Cryptographically signed locally via PyJWT (No Okta/Auth0 subscription needed)
OAUTH_SECRET_KEY=dev-enterprise-jwt-secret-key-change-in-production-rag-2026
OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_SIMULATION_OVERRIDE=true
REQUIRE_OAUTH_TOKEN=false
